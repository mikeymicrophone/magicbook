<% if resource.errors.any? %>
  <div class="auth-errors" id="error_explanation" data-turbo-cache="false">
    <p><%= pluralize(resource.errors.count, 'error') %> need<%= resource.errors.count == 1 ? 's' : '' %> your attention:</p>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
