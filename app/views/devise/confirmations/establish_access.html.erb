<%= render layout: 'devise/shared/panel', locals: {
  kicker: 'Mage account',
  title: 'Set a password',
  lede: 'One way to keep this account is with a password you can remember. Repeat it silently a few times before you save it.'
} do %>
  <div class="auth-form">
    <%= form_with(model: @mage, as: :mage, url: establish_password_path, html: { method: :put }) do |password_form| %>
      <div class="field">
        <%= password_form.label :password, 'Password' %>
        <% if @minimum_password_length %>
          <span class="auth-hint"><%= @minimum_password_length %> characters minimum</span>
        <% end %>
        <%= password_form.password_field :password, autofocus: true, autocomplete: 'new-password', required: true %>
      </div>

      <div class="field">
        <%= password_form.label :password_confirmation, 'Type it again' %>
        <%= password_form.password_field :password_confirmation, autocomplete: 'new-password', required: true %>
      </div>

      <div class="actions">
        <%= password_form.submit 'Save this password', class: 'auth-button auth-button-primary' %>
      </div>

      <%= password_form.hidden_field :reset_password_token, value: @mage.reset_password_token %>
    <% end %>
  </div>
<% end %>
