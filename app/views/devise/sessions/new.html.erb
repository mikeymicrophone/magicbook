<div class="login_area">
  <%= tag.div :class => :center do %>
    <%= wwemc_purchase "Buy the book to receive an account." %>
  <% end %>
  <div class="authentication_form">
    <div id="login_form">
      <h2><%= resource_name.capitalize %> Log in</h2>
      <h3>(if you purchased the book)</h3>

      <%= form_for(resource, as: resource_name, url: session_url(resource_name), data: {turbo: false}) do |f| %>
        <div class="field">
          <%= f.label :email %><br />
          <%= f.email_field :email, autofocus: true %>
        </div>

        <div class="field">
          <%= f.label :password %><br />
          <%= f.password_field :password, autocomplete: "off" %>
        </div>

        <% if devise_mapping.rememberable? -%>
          <div class="field">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me %>
          </div>
        <% end -%>

        <div class="actions">
          <%= f.submit "Log in" %>
        </div>
      <% end %>

      <p><%= link_to 'Email me a sign-in link', new_magic_link_path %></p>

      <% if Mage.google_oauth_configured? %>
        <%= button_to 'Continue with Google', mage_google_oauth2_omniauth_authorize_path,
          method: :post, form: { data: { turbo: false } } %>
      <% end %>

      <p>
        <button type="button"
          data-passkey-action="authenticate"
          data-options-url="<%= authentication_options_passkey_path %>"
          data-submit-url="<%= authenticate_passkey_path %>">
          Sign in with a passkey
        </button>
      </p>

      <%= render "devise/shared/links" %>
    </div>
  </div>


</div>
