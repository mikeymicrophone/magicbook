<%= render layout: 'devise/shared/panel', locals: {
  kicker: 'Mage account',
  title: 'Forgot your password?',
  lede: 'We’ll email reset instructions if this address has an account.'
} do %>
  <div class="auth-form">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', required: true %>
      </div>

      <div class="actions">
        <%= f.submit 'Email reset instructions', class: 'auth-button auth-button-primary' %>
      </div>
    <% end %>
  </div>

  <%= render 'devise/shared/links' %>
<% end %>
