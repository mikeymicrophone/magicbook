<%= render layout: 'devise/shared/panel', locals: {
  kicker: 'Mage account',
  title: 'Choose a new password',
  lede: 'Pick something you’ll remember, then sign in with it.'
} do %>
  <div class="auth-form">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <%= f.label :password, 'New password' %>
        <% if @minimum_password_length %>
          <span class="auth-hint"><%= @minimum_password_length %> characters minimum</span>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: 'new-password', required: true %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, 'Confirm new password' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', required: true %>
      </div>

      <div class="actions">
        <%= f.submit 'Change my password', class: 'auth-button auth-button-primary' %>
      </div>
    <% end %>
  </div>

  <%= render 'devise/shared/links' %>
<% end %>
