<% section = section_table_of_content.section %>
<%= turbo_frame_tag dom_id(section) do %>
  <%= div_with_data_for section do %>
    <%= div_for section, :data_on do %>
      <%= section_control section_table_of_content %>
    <% end %>
    <%= edit_controls_for_section section_table_of_content %>
    <%= content_tag :div, id: dom_id(section_table_of_content, :paragraphs) do %>
      <% book.table_of_contents.in_edition(edition).in_chapter(section_table_of_content.chapter).in_section(section).paragraphish.order(:ordering).each do |paragraph_table_of_content| %>
        <%= paragraph_control paragraph_table_of_content %>
      <% end %>
    <% end %>
    <%= append_to section_table_of_content %>
  <% end %>
<% end %>
