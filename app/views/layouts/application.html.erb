<!DOCTYPE html>
<html>
  <head>
    <title>Ways We Mage<%= @html_title ? " - #{@html_title}" : '' %></title>
    <%= csrf_meta_tags %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= google_analytics %>
    <%= google_fonts %>
    <%= yield :open_graph %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
    <% if ENV["UMAMI_SCRIPT_URL"].present? && ENV["UMAMI_WEBSITE_ID"].present? %>
      <%= tag.script defer: true, src: ENV["UMAMI_SCRIPT_URL"], data: {
        website_id: ENV["UMAMI_WEBSITE_ID"], domains: ENV["UMAMI_DOMAINS"], exclude_search: true, exclude_hash: true
      } %>
    <% end %>
  </head>

  <body>
    <%= site_logo %>
    <%= login_links %>
    <%= ways_we_mage_social_links %>
    <%= shelf %>
    <%= review_kit %>
    
    <%= yield %>
    
    <%#= footer_call_to_action %>
    <%= footer_links %>
  </body>
</html>
