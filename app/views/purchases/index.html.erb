<%= tag.div :class => 'purchases' do %>
  <% @purchases.each do |purchase| %>
    <%= div_for purchase do %>
      <%= div_for purchase, :date_of do %>
        On <%= purchase.created_at.strftime("%B %d") %> you bought
      <% end %>
      <% purchase.books.each do |book| %>
        <%= link_to book.title, book %>
      <% end %>
      <% if purchase.invitations.present? %>
        and shared with
        <%= div_for purchase, :people_with_access_to do %>
          <% purchase.invitations.each do |invitation| %>
            <%= div_for invitation do %>
              <%= invitation.mage.email %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <% if purchase.can_invite? %>
        <%= link_to 'Invite people', invite_invitations_path(purchase_id: purchase.id) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
